# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL for production)
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=trello
DATABASE_PASSWORD=trello123
DATABASE_NAME=trello_vibe
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=true

# Database (SQLite for development - comment out PostgreSQL above)
# DATABASE_TYPE=sqlite
# DATABASE_NAME=./dev.sqlite3

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# File Storage
FILE_UPLOAD_MAX_SIZE=10485760
FILE_UPLOAD_DIR=./uploads
FILE_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain

# CORS
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true
