<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Weekly Activity Digest</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background-color: #f5f5f5;
            color: #333333;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
        }
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 40px 30px;
            text-align: center;
        }
        .header h1 {
            margin: 0;
            color: #ffffff;
            font-size: 28px;
            font-weight: 600;
        }
        .header-subtitle {
            color: rgba(255, 255, 255, 0.9);
            font-size: 14px;
            margin-top: 10px;
        }
        .content {
            padding: 40px 30px;
        }
        .greeting {
            font-size: 18px;
            color: #333333;
            margin-bottom: 20px;
        }
        .summary-stats {
            display: table;
            width: 100%;
            margin: 30px 0;
        }
        .stat-item {
            display: table-cell;
            text-align: center;
            padding: 20px;
            background-color: #f8f9fa;
            border-radius: 8px;
        }
        .stat-item + .stat-item {
            padding-left: 10px;
        }
        .stat-number {
            font-size: 32px;
            font-weight: 700;
            color: #667eea;
            display: block;
        }
        .stat-label {
            font-size: 14px;
            color: #666666;
            text-transform: uppercase;
            margin-top: 5px;
        }
        .section {
            margin: 30px 0;
        }
        .section-title {
            font-size: 20px;
            font-weight: 600;
            color: #333333;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 2px solid #667eea;
        }
        .activity-item {
            background-color: #f8f9fa;
            border-left: 4px solid #667eea;
            padding: 15px;
            margin: 10px 0;
            border-radius: 4px;
        }
        .activity-title {
            font-weight: 600;
            color: #333333;
            font-size: 15px;
            margin-bottom: 5px;
        }
        .activity-meta {
            font-size: 13px;
            color: #666666;
            margin-top: 5px;
        }
        .board-section {
            background-color: #ffffff;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 20px;
            margin: 15px 0;
        }
        .board-name {
            font-size: 18px;
            font-weight: 600;
            color: #333333;
            margin-bottom: 10px;
        }
        .board-stats {
            font-size: 14px;
            color: #666666;
            margin: 5px 0;
        }
        .card-list {
            margin: 15px 0;
        }
        .card-item {
            padding: 10px;
            background-color: #f8f9fa;
            border-radius: 4px;
            margin: 8px 0;
            font-size: 14px;
        }
        .button {
            display: inline-block;
            padding: 14px 32px;
            background-color: #667eea;
            color: #ffffff !important;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 600;
            font-size: 16px;
            margin: 20px 0;
        }
        .button:hover {
            background-color: #5568d3;
        }
        .footer {
            background-color: #f8f9fa;
            padding: 30px;
            text-align: center;
            font-size: 14px;
            color: #666666;
        }
        .footer a {
            color: #667eea;
            text-decoration: none;
        }
        .divider {
            height: 1px;
            background-color: #e0e0e0;
            margin: 30px 0;
        }
        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: #999999;
            font-size: 16px;
        }
        .empty-icon {
            font-size: 48px;
            margin-bottom: 15px;
        }
        @media only screen and (max-width: 600px) {
            .content {
                padding: 30px 20px;
            }
            .header {
                padding: 30px 20px;
            }
            .summary-stats {
                display: block;
            }
            .stat-item {
                display: block;
                margin-bottom: 10px;
            }
            .stat-item + .stat-item {
                padding-left: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>📊 Weekly Digest</h1>
            <div class="header-subtitle">
                {{formatDate weekStart}} - {{formatDate weekEnd}}
            </div>
        </div>

        <!-- Content -->
        <div class="content">
            <div class="greeting">
                Hi {{userName}},
            </div>

            <div style="font-size: 16px; color: #666666; line-height: 1.6; margin-bottom: 20px;">
                Here's a summary of your team's activity this week.
            </div>

            <!-- Summary Stats -->
            <div class="summary-stats">
                <div class="stat-item">
                    <span class="stat-number">{{stats.cardsCreated}}</span>
                    <span class="stat-label">Cards Created</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number">{{stats.cardsCompleted}}</span>
                    <span class="stat-label">Cards Completed</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number">{{stats.comments}}</span>
                    <span class="stat-label">Comments</span>
                </div>
            </div>

            <!-- Boards Section -->
            {{#if boards}}
            <div class="section">
                <div class="section-title">Active Boards ({{boards.length}})</div>
                
                {{#each boards}}
                <div class="board-section">
                    <div class="board-name">{{this.name}}</div>
                    <div class="board-stats">
                        📋 {{this.stats.totalCards}} {{pluralize this.stats.totalCards "card"}} • 
                        ✅ {{this.stats.completedCards}} completed • 
                        👥 {{this.stats.members}} {{pluralize this.stats.members "member"}}
                    </div>
                    
                    {{#if this.topCards}}
                    <div class="card-list">
                        <strong style="font-size: 14px; color: #666666;">Most Active Cards:</strong>
                        {{#each this.topCards}}
                        <div class="card-item">
                            {{this.title}}
                            {{#if this.activityCount}}
                            <span style="color: #667eea;">• {{this.activityCount}} {{pluralize this.activityCount "update"}}</span>
                            {{/if}}
                        </div>
                        {{/each}}
                    </div>
                    {{/if}}
                </div>
                {{/each}}
            </div>
            {{/if}}

            <!-- Recent Activity -->
            {{#if recentActivity}}
            <div class="section">
                <div class="section-title">Recent Activity</div>
                
                {{#each recentActivity}}
                <div class="activity-item">
                    <div class="activity-title">{{this.title}}</div>
                    <div class="activity-meta">
                        {{this.user}} • {{this.board}} • {{formatDateTime this.timestamp}}
                    </div>
                </div>
                {{/each}}
            </div>
            {{/if}}

            <!-- Cards Assigned to You -->
            {{#if assignedCards}}
            <div class="section">
                <div class="section-title">
                    Cards Assigned to You ({{assignedCards.length}})
                </div>
                
                {{#each assignedCards}}
                <div class="card-item">
                    <strong>{{this.title}}</strong>
                    <div style="font-size: 13px; color: #666666; margin-top: 5px;">
                        {{this.boardName}} • {{this.listName}}
                        {{#if this.dueDate}}
                        • Due: {{formatDate this.dueDate}}
                        {{/if}}
                    </div>
                </div>
                {{/each}}
            </div>
            {{/if}}

            <!-- Overdue Cards Warning -->
            {{#if overdueCards}}
            <div class="section">
                <div class="section-title" style="color: #dc3545; border-bottom-color: #dc3545;">
                    ⚠️ Overdue Cards ({{overdueCards.length}})
                </div>
                
                {{#each overdueCards}}
                <div class="activity-item" style="border-left-color: #dc3545; background-color: #fff3f3;">
                    <div class="activity-title">{{this.title}}</div>
                    <div class="activity-meta" style="color: #dc3545;">
                        Due: {{formatDate this.dueDate}} • {{this.boardName}}
                    </div>
                </div>
                {{/each}}
            </div>
            {{/if}}

            <!-- Empty State -->
            {{#unless boards}}
            {{#unless recentActivity}}
            <div class="empty-state">
                <div class="empty-icon">📭</div>
                <div>No activity this week. Time to get started!</div>
            </div>
            {{/unless}}
            {{/unless}}

            <center>
                <a href="{{dashboardUrl}}" class="button">View Dashboard</a>
            </center>

            <div class="divider"></div>

            <div style="font-size: 14px; color: #666666; text-align: center;">
                <p>
                    <strong>Quick Links:</strong><br>
                    <a href="{{myCardsUrl}}" style="color: #667eea;">My Cards</a> • 
                    <a href="{{boardsUrl}}" style="color: #667eea;">All Boards</a> • 
                    <a href="{{activityUrl}}" style="color: #667eea;">Activity Feed</a>
                </p>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p>
                You're receiving this weekly digest for your Kanban Board account.
            </p>
            <p>
                <a href="{{unsubscribeUrl}}">Unsubscribe</a> • 
                <a href="{{preferencesUrl}}">Email Preferences</a>
            </p>
            <p style="margin-top: 20px; color: #999999;">
                © {{year}} Kanban Board. All rights reserved.
            </p>
        </div>
    </div>
</body>
</html>
