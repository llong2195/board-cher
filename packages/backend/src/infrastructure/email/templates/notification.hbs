<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{notificationType}} - {{boardName}}</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background-color: #f5f5f5;
            color: #333333;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
        }
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 40px 30px;
            text-align: center;
        }
        .header h1 {
            margin: 0;
            color: #ffffff;
            font-size: 28px;
            font-weight: 600;
        }
        .content {
            padding: 40px 30px;
        }
        .notification-box {
            background-color: #f8f9fa;
            border-left: 4px solid #667eea;
            padding: 20px;
            margin: 20px 0;
            border-radius: 4px;
        }
        .notification-type {
            font-size: 14px;
            color: #667eea;
            text-transform: uppercase;
            font-weight: 600;
            margin-bottom: 10px;
        }
        .notification-message {
            font-size: 16px;
            line-height: 1.6;
            color: #333333;
            margin: 10px 0;
        }
        .card-details {
            background-color: #ffffff;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 20px;
            margin: 20px 0;
        }
        .card-title {
            font-size: 20px;
            font-weight: 600;
            color: #333333;
            margin-bottom: 10px;
        }
        .card-meta {
            font-size: 14px;
            color: #666666;
            margin: 5px 0;
        }
        .card-description {
            font-size: 14px;
            color: #666666;
            line-height: 1.6;
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px solid #e0e0e0;
        }
        .button {
            display: inline-block;
            padding: 14px 32px;
            background-color: #667eea;
            color: #ffffff !important;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 600;
            font-size: 16px;
            margin: 20px 0;
        }
        .button:hover {
            background-color: #5568d3;
        }
        .footer {
            background-color: #f8f9fa;
            padding: 30px;
            text-align: center;
            font-size: 14px;
            color: #666666;
        }
        .footer a {
            color: #667eea;
            text-decoration: none;
        }
        .divider {
            height: 1px;
            background-color: #e0e0e0;
            margin: 30px 0;
        }
        @media only screen and (max-width: 600px) {
            .content {
                padding: 30px 20px;
            }
            .header {
                padding: 30px 20px;
            }
            .header h1 {
                font-size: 24px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>📋 Kanban Board Notification</h1>
        </div>

        <!-- Content -->
        <div class="content">
            <div class="notification-box">
                <div class="notification-type">{{notificationType}}</div>
                <div class="notification-message">
                    {{{message}}}
                </div>
            </div>

            {{#if card}}
            <div class="card-details">
                <div class="card-title">{{card.title}}</div>
                
                <div class="card-meta">
                    <strong>Board:</strong> {{boardName}}
                </div>
                
                {{#if card.list}}
                <div class="card-meta">
                    <strong>List:</strong> {{card.list}}
                </div>
                {{/if}}
                
                {{#if card.dueDate}}
                <div class="card-meta">
                    <strong>Due Date:</strong> {{formatDateTime card.dueDate}}
                </div>
                {{/if}}
                
                {{#if card.assignees}}
                <div class="card-meta">
                    <strong>Assigned to:</strong> {{card.assignees}}
                </div>
                {{/if}}
                
                {{#if card.description}}
                <div class="card-description">
                    {{truncate card.description 200}}
                </div>
                {{/if}}
            </div>
            {{/if}}

            {{#if actionUrl}}
            <center>
                <a href="{{actionUrl}}" class="button">View Card</a>
            </center>
            {{/if}}

            {{#if comment}}
            <div class="divider"></div>
            <div style="margin: 20px 0;">
                <strong>{{comment.author}}</strong> commented:
                <div style="margin-top: 10px; padding: 15px; background-color: #f8f9fa; border-radius: 4px; font-size: 14px; color: #333333;">
                    {{comment.text}}
                </div>
                <div style="font-size: 12px; color: #999999; margin-top: 8px;">
                    {{formatDateTime comment.createdAt}}
                </div>
            </div>
            {{/if}}
        </div>

        <!-- Footer -->
        <div class="footer">
            <p>
                You received this email because you're subscribed to notifications for this board.
            </p>
            <p>
                <a href="{{unsubscribeUrl}}">Unsubscribe</a> • 
                <a href="{{preferencesUrl}}">Notification Preferences</a>
            </p>
            <p style="margin-top: 20px; color: #999999;">
                © {{year}} Kanban Board. All rights reserved.
            </p>
        </div>
    </div>
</body>
</html>
