<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>You've been invited to {{organizationName}}</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background-color: #f5f5f5;
            color: #333333;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
        }
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 40px 30px;
            text-align: center;
        }
        .header h1 {
            margin: 0;
            color: #ffffff;
            font-size: 28px;
            font-weight: 600;
        }
        .content {
            padding: 40px 30px;
        }
        .invitation-box {
            text-align: center;
            padding: 40px 20px;
        }
        .invitation-icon {
            font-size: 64px;
            margin-bottom: 20px;
        }
        .invitation-title {
            font-size: 24px;
            font-weight: 600;
            color: #333333;
            margin-bottom: 15px;
        }
        .invitation-message {
            font-size: 16px;
            color: #666666;
            line-height: 1.6;
            margin-bottom: 30px;
        }
        .inviter-info {
            background-color: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            margin: 30px 0;
            text-align: left;
        }
        .inviter-info h3 {
            margin: 0 0 15px 0;
            font-size: 18px;
            color: #333333;
        }
        .info-row {
            margin: 10px 0;
            font-size: 14px;
            color: #666666;
        }
        .info-label {
            font-weight: 600;
            color: #333333;
            display: inline-block;
            width: 120px;
        }
        .button {
            display: inline-block;
            padding: 16px 40px;
            background-color: #667eea;
            color: #ffffff !important;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 600;
            font-size: 16px;
            margin: 20px 0;
        }
        .button:hover {
            background-color: #5568d3;
        }
        .button-secondary {
            display: inline-block;
            padding: 12px 24px;
            background-color: transparent;
            color: #667eea !important;
            text-decoration: none;
            border: 2px solid #667eea;
            border-radius: 6px;
            font-weight: 600;
            font-size: 14px;
            margin: 10px 5px;
        }
        .expiry-notice {
            background-color: #fff3cd;
            border-left: 4px solid #ffc107;
            padding: 15px;
            margin: 20px 0;
            border-radius: 4px;
            font-size: 14px;
            color: #856404;
        }
        .footer {
            background-color: #f8f9fa;
            padding: 30px;
            text-align: center;
            font-size: 14px;
            color: #666666;
        }
        .footer a {
            color: #667eea;
            text-decoration: none;
        }
        .divider {
            height: 1px;
            background-color: #e0e0e0;
            margin: 30px 0;
        }
        @media only screen and (max-width: 600px) {
            .content {
                padding: 30px 20px;
            }
            .header {
                padding: 30px 20px;
            }
            .header h1 {
                font-size: 24px;
            }
            .invitation-title {
                font-size: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>🎉 You're Invited!</h1>
        </div>

        <!-- Content -->
        <div class="content">
            <div class="invitation-box">
                <div class="invitation-icon">✉️</div>
                <div class="invitation-title">
                    Join {{organizationName}}{{#if boardName}} - {{boardName}}{{/if}}
                </div>
                <div class="invitation-message">
                    {{inviterName}} has invited you to collaborate on 
                    {{#if boardName}}
                        the <strong>{{boardName}}</strong> board in <strong>{{organizationName}}</strong>
                    {{else}}
                        <strong>{{organizationName}}</strong>
                    {{/if}}.
                </div>
            </div>

            {{#if invitationMessage}}
            <div style="background-color: #f8f9fa; border-radius: 8px; padding: 20px; margin: 20px 0;">
                <strong>Message from {{inviterName}}:</strong>
                <div style="margin-top: 10px; color: #666666; font-size: 14px; line-height: 1.6;">
                    "{{invitationMessage}}"
                </div>
            </div>
            {{/if}}

            <div class="inviter-info">
                <h3>Invitation Details</h3>
                <div class="info-row">
                    <span class="info-label">From:</span>
                    <span>{{inviterName}}</span>
                </div>
                {{#if inviterEmail}}
                <div class="info-row">
                    <span class="info-label">Email:</span>
                    <span>{{inviterEmail}}</span>
                </div>
                {{/if}}
                {{#if role}}
                <div class="info-row">
                    <span class="info-label">Your Role:</span>
                    <span style="text-transform: capitalize;">{{role}}</span>
                </div>
                {{/if}}
                {{#if expiresAt}}
                <div class="info-row">
                    <span class="info-label">Expires:</span>
                    <span>{{formatDateTime expiresAt}}</span>
                </div>
                {{/if}}
            </div>

            {{#if expiresAt}}
            <div class="expiry-notice">
                ⚠️ This invitation will expire on {{formatDate expiresAt}}. Please accept it before then.
            </div>
            {{/if}}

            <center>
                <a href="{{acceptUrl}}" class="button">Accept Invitation</a>
                <br>
                <a href="{{declineUrl}}" class="button-secondary">Decline</a>
            </center>

            <div class="divider"></div>

            <div style="font-size: 14px; color: #666666; text-align: center;">
                <p>
                    By accepting this invitation, you'll be able to:
                </p>
                <ul style="text-align: left; display: inline-block; margin: 15px 0;">
                    {{#if boardName}}
                    <li>View and collaborate on the <strong>{{boardName}}</strong> board</li>
                    <li>Create and manage cards</li>
                    <li>Comment and interact with team members</li>
                    {{else}}
                    <li>Access all boards in <strong>{{organizationName}}</strong></li>
                    <li>Collaborate with team members</li>
                    <li>Create and manage your own boards</li>
                    {{/if}}
                    <li>Receive real-time updates</li>
                </ul>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p>
                This invitation was sent to {{recipientEmail}}.
            </p>
            {{#if needsAccount}}
            <p>
                Don't have an account? <a href="{{signupUrl}}">Sign up for free</a>
            </p>
            {{/if}}
            <p style="margin-top: 20px; color: #999999;">
                If you didn't expect this invitation, you can safely ignore this email.
            </p>
            <p style="margin-top: 20px; color: #999999;">
                © {{year}} Kanban Board. All rights reserved.
            </p>
        </div>
    </div>
</body>
</html>
